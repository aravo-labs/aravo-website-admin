# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Agent instruction files. `next dev` regenerates AGENTS.md on every run
# (node_modules/next/dist/server/lib/generate-agent-files.js), so deleting it
# is not enough on its own - ignored here so it stays out of the repo instead
# of reappearing as an uncommitted change every time the dev server starts.
AGENTS.md
