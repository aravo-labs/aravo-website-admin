# The platform API, not the CMS one.
NEXT_PUBLIC_API_URL=http://localhost:8020

# Supabase, for admin sign-in. This is the PLATFORM project, which is a
# different project from the one the CMS admin uses: the two have unrelated
# role models and do not share identities.
#
# Only the anon / publishable key belongs in a NEXT_PUBLIC_ variable - it is
# compiled into the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
